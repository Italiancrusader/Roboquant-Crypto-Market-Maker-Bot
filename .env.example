# Copy to .env and fill in. NEVER commit the real .env file.
#
# HL_WALLET_ADDRESS: your Hyperliquid ACCOUNT address (0x...) — the address
#                    your funds live under (top-right in the Hyperliquid app).
#                    NOT the API wallet's own address: with an API wallet the
#                    key signs, but this address is what gets watched/traded.
# HL_PRIVATE_KEY:    the private key of an API wallet created at
#                    https://app.hyperliquid.xyz/API (recommended), or of the
#                    account itself. Use a dedicated API wallet so the key
#                    cannot withdraw funds.
HL_WALLET_ADDRESS=0xYourAccountAddress
HL_PRIVATE_KEY=0xYourApiWalletPrivateKey

# Optional: separate testnet credentials. When config.json has "testnet": true
# these take precedence over the two variables above. HL_TESTNET_WALLET_ADDRESS
# must be the ACCOUNT address (the one holding funds), not the API wallet's
# own address — the API wallet key only signs on the account's behalf.
#HL_TESTNET_WALLET_ADDRESS=0xYourAccountAddress
#HL_TESTNET_PRIVATE_KEY=0xYourTestnetApiWalletPrivateKey
